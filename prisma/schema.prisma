generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  role         UserRole @default(CUSTOMER)
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Admin account lockout: counts consecutive failed login attempts;
  // locked accounts auto-unlock when lockedUntil passes.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  // Set by an admin to block sign-in without deleting the account or its
  // order history. Null = active.
  suspendedAt DateTime?

  requests          PartRequest[]      @relation("CustomerRequests")
  quotesSent        PartRequest[]      @relation("QuotedBy")
  statusUpdates     StatusLog[]
  notifications     Notification[]
  paymentsConfirmed Payment[]          @relation("PaymentsConfirmed")
  adminActivity     AdminActivityLog[] @relation("AdminActivity")
}

// One-time codes for phone login. Codes are 6 digits, short-lived, single-use.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// ─── Vehicle taxonomy ────────────────────────────────────────────────────────

model Brand {
  id     String     @id @default(cuid())
  name   String     @unique
  active Boolean    @default(true)
  models CarModel[]

  requests PartRequest[]
}

model CarModel {
  id      String @id @default(cuid())
  name    String
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  yearRanges YearRange[]
  requests   PartRequest[]

  @@unique([brandId, name])
}

model YearRange {
  id         String   @id @default(cuid())
  startYear  Int
  endYear    Int
  carModelId String
  carModel   CarModel @relation(fields: [carModelId], references: [id], onDelete: Cascade)

  requests PartRequest[]

  @@unique([carModelId, startYear, endYear])
}

// ─── Part taxonomy ───────────────────────────────────────────────────────────

// Names carry optional Kurdish (Sorani) and Arabic translations for the
// multilingual UI; `name` is the English fallback.

model Category {
  id     String @id @default(cuid())
  name   String @unique
  nameKu String?
  nameAr String?
  sortOrder Int  @default(0)

  subCategories SubCategory[]
}

model SubCategory {
  id         String   @id @default(cuid())
  name       String
  nameKu     String?
  nameAr     String?
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  parts Part[]

  @@unique([categoryId, name])
}

model Part {
  id                String      @id @default(cuid())
  name              String
  nameKu            String?
  nameAr            String?
  requiresColorCode Boolean     @default(false)
  // Optional indicative price range shown to customers before they submit
  // (rough estimate set by admin — never a firm quote).
  priceMinUsd       Decimal?    @db.Decimal(10, 2)
  priceMaxUsd       Decimal?    @db.Decimal(10, 2)
  subCategoryId     String
  subCategory       SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  requests PartRequest[]

  @@unique([subCategoryId, name])
}

// ─── Requests / quotes / orders ──────────────────────────────────────────────

enum RequestStatus {
  PENDING // submitted, waiting for admin quote
  QUOTED // admin sent a price
  APPROVED // customer accepted the quote
  REJECTED // customer declined the quote
  PAID // payment received/confirmed
  SOURCING // admin ordered from supplier
  SHIPPED // on its way to Kurdistan
  ARRIVED // in country
  READY // ready for pickup/delivery
  COMPLETED
  CANCELLED
}

enum SourceCountry {
  CHINA
  DUBAI
}

// Payment channels. The three online methods are Iraq-specific; cash on
// delivery is only offered for a REMAINDER balance, never the first payment.
enum PaymentMethod {
  FIB
  FASTPAY
  QICARD
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
}

model PartRequest {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation("CustomerRequests", fields: [customerId], references: [id])

  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id])
  carModelId  String
  carModel    CarModel  @relation(fields: [carModelId], references: [id])
  yearRangeId String
  yearRange   YearRange @relation(fields: [yearRangeId], references: [id])
  partId      String
  part        Part      @relation(fields: [partId], references: [id])

  colorCode String?
  notes     String?
  photoUrl  String?

  // Customer's requested sourcing route (China ≈ 2 months, Dubai ≈ 20 days).
  // Advisory: admin sees it and may source differently; `source` below is
  // what was actually quoted.
  preferredSource SourceCountry?

  status RequestStatus @default(PENDING)

  // Quote (filled by admin). priceUsd is the TOTAL the customer pays and is
  // what the payment/notification flows read; the four components below
  // itemize it. Historical quotes (pre-itemization) were backfilled with
  // pricePartUsd = priceUsd and the other components left null.
  source           SourceCountry?
  priceUsd         Decimal?       @db.Decimal(10, 2)
  pricePartUsd     Decimal?       @db.Decimal(10, 2)
  priceShippingUsd Decimal?       @db.Decimal(10, 2)
  priceTaxUsd      Decimal?       @db.Decimal(10, 2)
  priceDeliveryUsd Decimal?       @db.Decimal(10, 2)
  quoteNotes       String?
  quotedById String?
  quotedBy   User?          @relation("QuotedBy", fields: [quotedById], references: [id])
  quotedAt   DateTime?

  // Customer decision + payment. Money paid is the sum of this request's
  // CONFIRMED Payment rows (see Payment model) — there is deliberately no
  // single lump paymentMethod field, since a request can be settled across
  // several payments (half now, remainder later). paidAt is stamped only once
  // the full balance is confirmed.
  approvedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusLogs    StatusLog[]
  notifications Notification[]
  payments      Payment[]

  @@index([status])
  @@index([customerId])
}

// ─── Payments ────────────────────────────────────────────────────────────────

// One customer payment attempt against a request. A request's "amount paid" is
// the sum of its CONFIRMED payments; "remaining balance" is priceUsd minus that
// sum. Every payment starts PENDING_CONFIRMATION and is manually confirmed (or
// rejected, with a reason) by an admin who has verified the money arrived.
model Payment {
  id        String      @id @default(cuid())
  requestId String
  request   PartRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  amountUsd Decimal       @db.Decimal(10, 2)
  method    PaymentMethod

  // Who sent it (for the admin to match against the incoming transfer).
  // Null for cash on delivery, which has no online sender identity.
  senderAccountName String?
  senderPhone       String?
  proofUrl          String? // optional receipt the customer chose to attach

  status   PaymentStatus @default(PENDING_CONFIRMATION)
  adminNote String?      // required reason when REJECTED; shown to the customer

  confirmedByAdminId String?
  confirmedByAdmin   User?   @relation("PaymentsConfirmed", fields: [confirmedByAdminId], references: [id], onDelete: SetNull)
  confirmedAt        DateTime?

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([status])
}

// Admin-configurable business accounts customers send payments to. Keyed by
// method (only the three online methods are used). These are business details,
// not secrets — no encryption needed, but the edit screen is admin-only.
model PaymentReceivingAccount {
  method               PaymentMethod @id
  accountName          String
  accountNumberOrPhone String
  // Optional second identifier for methods that need two values. Qi Card is
  // identified by BOTH a card/account number and the registered phone, and
  // customers need both to send money — so they are stored and displayed as
  // two separate labelled fields rather than one concatenated string.
  accountNumberOrPhone2 String?
  updatedAt            DateTime      @updatedAt
}

model StatusLog {
  id        String        @id @default(cuid())
  requestId String
  request   PartRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status    RequestStatus
  // `note` holds an English snapshot. System-generated entries also set
  // noteKey + noteParams so the timeline can be re-rendered in the reader's
  // language (same pattern as Notification.templateKey). Free text an admin
  // typed has no noteKey and is shown exactly as written, in any language.
  note        String?
  noteKey     String?
  noteParams  Json?
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id])
  createdAt DateTime      @default(now())

  @@index([requestId])
}

// ─── Admin audit ─────────────────────────────────────────────────────────────

// Every admin login attempt (success, password fail, lockout hit) is recorded
// here for basic audit visibility on the dashboard.
model AdminLoginLog {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  ip        String
  success   Boolean
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Meaningful admin actions across the system (quotes, payments, status
// overrides, customer account changes, taxonomy imports). Sits alongside
// AdminLoginLog, which stays focused on authentication attempts; the admin
// activity screen shows both. Entries are immutable and admin-facing, so the
// summary is stored in English rather than translated.
model AdminActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AdminActivity", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String // snapshot so the record survives account deletion
  action     String // QUOTE_SENT, PAYMENT_CONFIRMED, STATUS_OVERRIDDEN, …
  targetType String? // "request" | "customer" | "taxonomy"
  targetId   String?
  // Deliberately English, unlike customer-facing notifications and request
  // timelines: an audit trail is a technical record and must read identically
  // for every admin regardless of their interface language.
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ─── Abuse counters + threat detection ───────────────────────────────────────

// Generic expiring counter, keyed by an opaque string. Backs two things:
//
//   "rl:<scope>:<id>"    fixed-window rate-limit buckets
//   "seen:<kind>:<ip>:<subject>"
//                        a marker that one IP has failed against one account /
//                        phone recently. Counting rows under the
//                        "seen:<kind>:<ip>:" prefix gives the number of
//                        DISTINCT accounts that IP has attacked, which is what
//                        separates credential stuffing from one person
//                        mistyping their own password.
//
// This lives in Postgres rather than process memory so counters survive
// redeploys and stay correct if the app ever runs more than one instance.
// Rows are pruned opportunistically once expired.
model RateCounter {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// A detected attack pattern, raised by src/lib/threat-detection.ts. Kept
// separate from AdminActivityLog so hostile traffic is never mixed in with
// ordinary staff actions — it has its own alert bar and its own section on the
// activity screen, and stays visible until an admin acknowledges it.
// Details are English for the same reason as the rest of the audit trail.
model SecurityEvent {
  id             String    @id @default(cuid())
  kind           String // CREDENTIAL_STUFFING, OTP_ABUSE, ADMIN_TARGETING, HIGH_VOLUME
  ip             String
  // How many distinct accounts/phones were hit, or how many requests were
  // seen — meaning depends on kind, and the detail string spells it out.
  observed       Int
  detail         String
  // Repeat detections from the same IP fold into the open event instead of
  // creating a new row per attempt, so one attack is one alert.
  hitCount       Int       @default(1)
  lastSeenAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime  @default(now())

  @@index([acknowledgedAt, createdAt])
  @@index([kind, ip, acknowledgedAt])
}

// ─── Notifications (in-app; WhatsApp delivery hooks onto the same rows) ──────

model Notification {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String?
  request   PartRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  type      String // e.g. QUOTE_SENT, PAYMENT_CONFIRMED, STATUS_UPDATE
  // title/body hold an English snapshot (fallback + future WhatsApp send).
  // templateKey + params let the in-app list re-render in the viewer's
  // current language instead of the language the notification was created in.
  templateKey String?
  params      Json?
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, readAt])
}
