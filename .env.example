# Copy to .env and fill in real values
DATABASE_URL="postgresql://carparts:carparts@localhost:5433/carparts"
JWT_SECRET="generate-a-long-random-string"

# Public origin of the deployed site, no trailing slash. Used to build the
# absolute og:image / twitter:image URLs in link previews — leave it unset and
# they point at localhost, which crawlers can't fetch, so shared links show no
# preview image.
NEXT_PUBLIC_SITE_URL="https://kalarycarpart.com"

# Business accounts customers are told to send payments to. These are not
# secrets — every customer sees them on the payment screen — but they are kept
# out of source so real numbers aren't committed. Read by `prisma db seed`.
# Leave unset and the seed writes clearly-labelled placeholders, which the app
# flags in admin settings and on the customer payment screen.
PAYMENT_ACCOUNT_HOLDER="Business Account Holder"
PAYMENT_FIB_PHONE="+9640000000000"
PAYMENT_FASTPAY_PHONE="+9640000000000"
PAYMENT_QICARD_NUMBER="0000000000"
PAYMENT_QICARD_PHONE="+9640000000000"
